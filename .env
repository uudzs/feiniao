#设置开启调试模式
APP_DEBUG = false

 #开启跟踪器
APP_TRACE = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[LANG]
# 开启多语言
lang_switch_on = true
# 默认语言（如 zh-cn）
default_lang = zh-cn
# 允许的语言列表
lang_allow_list = en-us,zh-cn

[TTS]
# TTS 服务地址
BASE_URL = http://127.0.0.1:25008
# 是否开启 Token 验证（需与 tts_server.py 中 ENABLE_TOKEN_AUTH 保持一致）
AUTH_ENABLED = true

[TRANSLATE]
# 翻译服务地址
BASE_URL = http://127.0.0.1:25009

[REVERSE_COLLECT]
ENABLED = false
COLLECTOR_BASE_URL = http://127.0.0.1:9001
COLLECTOR_API_KEY = collect_2026_secret_key_abc123
CALLBACK_BASE_URL = http://127.0.0.1:10999
CALLBACK_SECRET = collect_2026_secret_key_abc123
CATALOG_REFRESH_SECONDS = 21600
CHAPTER_REFRESH_SECONDS = 86400
DISPATCH_TIMEOUT = 5
MAX_ATTEMPTS = 5