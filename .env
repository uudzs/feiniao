#设置开启调试模式
APP_DEBUG = true

 #开启跟踪器
APP_TRACE = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[LANG]
# 开启多语言
lang_switch_on = true
# 默认语言（如 zh-cn）
default_lang = zh-cn
# 允许的语言列表
lang_allow_list = zh-cn,en-us

[CACHE]
DRIVER = file
CACHE_PREFIX = fn_cache:
CACHE_TAG_PREFIX = fn_tag_cache:

[REDIS]
REDIS_HOSTNAME = 127.0.0.1
PORT = 6379
REDIS_PASSWORD = 
SELECT = 1